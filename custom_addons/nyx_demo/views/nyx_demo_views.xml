<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nyx_demo_item_list" model="ir.ui.view">
        <field name="name">nyx.demo.item.list</field>
        <field name="model">nyx.demo.item</field>
        <field name="arch" type="xml">
            <list string="Demo Items" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="qty"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="view_nyx_demo_item_form" model="ir.ui.view">
        <field name="name">nyx.demo.item.form</field>
        <field name="model">nyx.demo.item</field>
        <field name="arch" type="xml">
            <form string="Demo Item">
                <header>
                    <button name="action_mark_done" type="object" string="Mark as Done"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" placeholder="Free text..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nyx_demo_item" model="ir.actions.act_window">
        <field name="name">Demo Items</field>
        <field name="res_model">nyx.demo.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first demo item</p>
        </field>
    </record>

    <menuitem id="menu_nyx_demo_root" name="Nyx Demo" sequence="90"/>
    <menuitem id="menu_nyx_demo_items" name="Demo Items" parent="menu_nyx_demo_root"
              action="action_nyx_demo_item" sequence="10"/>

</odoo>
